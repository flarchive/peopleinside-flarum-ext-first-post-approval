{
    "name": "peopleinside/flarum-ext-first-post-approval",
    "description": "Hold posts and discussions from new users for approval",
    "keywords": [
        "flarum",
        "approval"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0",
        "flarum/flags": "^2.0",
        "flarum/approval": "^2.0"
    },
    "authors": [
        {
            "name": "Clark Winkelmann",
            "homepage": "https://github.com/clarkwinkelmann",
            "role": "Original Developer"
        },
        {
            "name": "PeopleInside",
            "homepage": "https://github.com/PeopleInside",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/PeopleInside/flarum-ext-first-post-approval/issues",
        "source": "https://github.com/PeopleInside/flarum-ext-first-post-approval"
    },
    "autoload": {
        "psr-4": {
            "PeopleInside\\FirstPostApproval\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "First Post Approval",
            "category": "moderation",
            "icon": {
                "name": "fas fa-check",
                "backgroundColor": "#684ba6",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
